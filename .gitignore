# Local-only proof-of-concept assets
scripts/assets.local/

# Local wireless captures (may contain MAC addresses)
*.pcap
*.pcapng

# Firmware, keys, and proprietary blobs (never commit)
firmware/
keys/
*.keys
*.nca
*.nsp
*.xci
*.kip
*.kip1
*.pk11
*.pkg1
*.pkg2
*.nro
*.nso
